// Detects accounts with multiple failed sign-in attempts (password spray pattern)
// ResultType 50126 = invalid username or password
SigninLogs
| where TimeGenerated > ago(24h)
| where ResultType == "50126"
| summarize FailedAttempts = count() by UserPrincipalName, IPAddress, bin(TimeGenerated, 1h)
| where FailedAttempts > 3
| order by FailedAttempts desc
